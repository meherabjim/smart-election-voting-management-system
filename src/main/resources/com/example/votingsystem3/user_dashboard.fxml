<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.UserDashboardController"
            prefWidth="1100"
            prefHeight="720"
            style="-fx-background-color: #eef5fb;">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox alignment="CENTER"
              spacing="5"
              style="-fx-background-color: linear-gradient(to right, #0d47a1, #1976d2);
                     -fx-padding: 18 20 18 20;">

            <Label text="Live Election Monitoring"
                   style="-fx-font-size: 30px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Bangladesh Election Live Monitoring Dashboard"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #e3f2fd;"/>

        </VBox>

    </top>

    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">

            <content>

                <VBox alignment="TOP_CENTER"
                      spacing="20"
                      fillWidth="true">

                    <padding>
                        <Insets top="20"
                                right="40"
                                bottom="25"
                                left="40"/>
                    </padding>

                    <!-- ===================================== -->
                    <!-- SECTION 1: BANGLADESH LIVE VOTE CAST -->
                    <!-- ===================================== -->

                    <VBox alignment="CENTER"
                          spacing="7"
                          maxWidth="1000"
                          prefWidth="1000"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: #cfe1ef;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(
                                     three-pass-box,
                                     rgba(0,0,0,0.12),
                                     9,
                                     0,
                                     0,
                                     3
                                 );">

                        <Label text="BANGLADESH LIVE VOTE CAST"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #607d8b;"/>

                        <Label fx:id="bangladeshLiveCountLabel"
                               text="Bangladesh Live Votes Cast: 0"
                               alignment="CENTER"
                               style="-fx-font-size: 31px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #0d47a1;"/>

                        <Label text="The national vote-cast total updates automatically."
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #78909c;"/>

                    </VBox>

                    <!-- ===================================== -->
                    <!-- SECTION 2: BANGLADESH RESULTS        -->
                    <!-- ===================================== -->

                    <VBox alignment="CENTER"
                          spacing="13"
                          maxWidth="1000"
                          prefWidth="1000"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: #cfe1ef;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(
                                     three-pass-box,
                                     rgba(0,0,0,0.12),
                                     9,
                                     0,
                                     0,
                                     3
                                 );">

                        <Label text="Bangladesh Submitted Results"
                               style="-fx-font-size: 23px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #0d47a1;"/>

                        <Label text="Only polling stations that submitted final results are included."
                               alignment="CENTER"
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #607d8b;"/>

                        <Separator/>

                        <VBox alignment="CENTER"
                              spacing="4"
                              maxWidth="600"
                              style="-fx-background-color: #ede7f6;
                                     -fx-background-radius: 10;
                                     -fx-border-radius: 10;
                                     -fx-border-color: #b39ddb;
                                     -fx-padding: 12 20 12 20;">

                            <Label text="RESULT SUBMISSION PROGRESS"
                                   style="-fx-font-size: 11px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #5e35b1;"/>

                            <Label fx:id="nationalProgressLabel"
                                   text="Final results submitted: 0 / 0 polling stations"
                                   alignment="CENTER"
                                   wrapText="true"
                                   style="-fx-font-size: 16px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #4527a0;"/>

                        </VBox>

                        <HBox alignment="CENTER"
                              spacing="20">

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  style="-fx-background-color: #e8f5e9;
                                         -fx-background-radius: 9;
                                         -fx-padding: 12;">

                                <Label text="TOTAL VALID VOTES"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #558b2f;"/>

                                <Label fx:id="nationalValidLabel"
                                       text="Valid Votes: 0"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #2e7d32;"/>

                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  style="-fx-background-color: #ffebee;
                                         -fx-background-radius: 9;
                                         -fx-padding: 12;">

                                <Label text="TOTAL INVALID VOTES"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #c62828;"/>

                                <Label fx:id="nationalInvalidLabel"
                                       text="Invalid Votes: 0"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #c62828;"/>

                            </VBox>

                        </HBox>

                        <Label text="Candidate-wise Bangladesh Total"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #263238;"/>

                        <TableView fx:id="bdTable"
                                   prefHeight="190"
                                   maxWidth="930"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #d7e3ec;
                                          -fx-border-radius: 6;">

                            <placeholder>

                                <Label text="No polling station result has been submitted."
                                       style="-fx-text-fill: #78909c;"/>

                            </placeholder>

                            <columns>

                                <TableColumn fx:id="candidateCol2"
                                             text="Candidate"
                                             prefWidth="600"/>

                                <TableColumn fx:id="votesCol2"
                                             text="Submitted Total Votes"
                                             prefWidth="300"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- ===================================== -->
                    <!-- SECTION 3: POLLING STATION SELECTION -->
                    <!-- ===================================== -->

                    <VBox alignment="CENTER"
                          spacing="14"
                          maxWidth="1000"
                          prefWidth="1000"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: #cfe1ef;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(
                                     three-pass-box,
                                     rgba(0,0,0,0.12),
                                     9,
                                     0,
                                     0,
                                     3
                                 );">

                        <Label text="Polling Station Live Monitoring"
                               style="-fx-font-size: 23px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #0d47a1;"/>

                        <Label text="Select Division, District, Upazila and Polling Station."
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #607d8b;"/>

                        <Separator/>

                        <HBox alignment="CENTER"
                              spacing="12">

                            <VBox spacing="5">

                                <Label text="Division"
                                       style="-fx-font-weight: bold;
                                              -fx-text-fill: #37474f;"/>

                                <ComboBox fx:id="divCombo"
                                          promptText="Select Division"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="District"
                                       style="-fx-font-weight: bold;
                                              -fx-text-fill: #37474f;"/>

                                <ComboBox fx:id="disCombo"
                                          promptText="Select District"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="Upazila"
                                       style="-fx-font-weight: bold;
                                              -fx-text-fill: #37474f;"/>

                                <ComboBox fx:id="upaCombo"
                                          promptText="Select Upazila"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="Polling Station"
                                       style="-fx-font-weight: bold;
                                              -fx-text-fill: #37474f;"/>

                                <ComboBox fx:id="stationCombo"
                                          promptText="Select Polling Station"
                                          prefWidth="245"
                                          prefHeight="38"/>

                            </VBox>

                        </HBox>

                        <VBox alignment="CENTER"
                              spacing="4"
                              maxWidth="720"
                              style="-fx-background-color: #e3f2fd;
                                     -fx-background-radius: 10;
                                     -fx-border-radius: 10;
                                     -fx-border-color: #90caf9;
                                     -fx-padding: 14 20 14 20;">

                            <Label text="SELECTED POLLING STATION LIVE STATUS"
                                   style="-fx-font-size: 11px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #546e7a;"/>

                            <Label fx:id="selectedStationLiveCountLabel"
                                   text="Select a polling station."
                                   alignment="CENTER"
                                   wrapText="true"
                                   style="-fx-font-size: 21px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1565c0;"/>

                        </VBox>

                    </VBox>

                    <!-- ===================================== -->
                    <!-- SECTION 4: SELECTED STATION RESULT   -->
                    <!-- ===================================== -->

                    <VBox alignment="CENTER"
                          spacing="13"
                          maxWidth="1000"
                          prefWidth="1000"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: #cfe1ef;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(
                                     three-pass-box,
                                     rgba(0,0,0,0.12),
                                     9,
                                     0,
                                     0,
                                     3
                                 );">

                        <Label text="Selected Polling Station Final Result"
                               style="-fx-font-size: 23px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #0d47a1;"/>

                        <Label fx:id="stationResultStatusLabel"
                               text="Select a polling station to see its result status."
                               alignment="CENTER"
                               wrapText="true"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #546e7a;"/>

                        <HBox alignment="CENTER"
                              spacing="20">

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  style="-fx-background-color: #e8f5e9;
                                         -fx-background-radius: 9;
                                         -fx-padding: 12;">

                                <Label text="STATION VALID VOTES"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #558b2f;"/>

                                <Label fx:id="stationValidLabel"
                                       text="Valid Votes: 0"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #2e7d32;"/>

                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  style="-fx-background-color: #ffebee;
                                         -fx-background-radius: 9;
                                         -fx-padding: 12;">

                                <Label text="STATION INVALID VOTES"
                                       style="-fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #c62828;"/>

                                <Label fx:id="stationInvalidLabel"
                                       text="Invalid Votes: 0"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #c62828;"/>

                            </VBox>

                        </HBox>

                        <TableView fx:id="stationTable"
                                   prefHeight="210"
                                   maxWidth="930"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #d7e3ec;
                                          -fx-border-radius: 6;">

                            <placeholder>

                                <Label text="No submitted result is available for the selected polling station."
                                       style="-fx-text-fill: #78909c;"/>

                            </placeholder>

                            <columns>

                                <TableColumn fx:id="candidateCol1"
                                             text="Candidate"
                                             prefWidth="600"/>

                                <TableColumn fx:id="votesCol1"
                                             text="Polling Station Votes"
                                             prefWidth="300"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER"
              style="-fx-background-color: #dbeaf5;
                     -fx-padding: 10 20 12 20;">

            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="110"
                    prefHeight="38"
                    style="-fx-background-color: #d32f2f;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 7;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>
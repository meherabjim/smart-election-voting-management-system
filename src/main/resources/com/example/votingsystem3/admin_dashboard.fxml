<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.AdminDashboardController"
            prefWidth="1180"
            prefHeight="760"
            stylesheets="@app-theme.css"
            styleClass="page-shell">

    <top>
        <VBox alignment="CENTER"
              styleClass="top-banner">

            <Label text="POLLING STATION ADMIN DASHBOARD"
                   styleClass="main-title"/>

            <Label fx:id="stationNameLabel"
                   text="Polling Station"
                   styleClass="subtitle"/>

        </VBox>
    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <HBox alignment="TOP_CENTER"
                      spacing="22">

                    <padding>
                        <Insets top="22"
                                right="25"
                                bottom="22"
                                left="25"/>
                    </padding>

                    <!-- LEFT SIDE -->

                    <VBox spacing="14"
                          prefWidth="550"
                          styleClass="section-card">

                        <Label text="Final Candidate Result"
                               styleClass="section-title"/>

                        <Label fx:id="pollingStatusLabel"
                               text="Polling Status"
                               styleClass="status-label"/>

                        <TableView fx:id="resultTable"
                                   prefHeight="250"
                                   editable="true">

                            <columns>

                                <TableColumn fx:id="candidateNameCol"
                                             text="Candidate"
                                             prefWidth="245"/>

                                <TableColumn fx:id="voteCountCol"
                                             text="Saved Votes"
                                             prefWidth="130"/>

                                <TableColumn fx:id="updateVoteCol"
                                             text="Final Count"
                                             prefWidth="130"/>

                            </columns>

                        </TableView>

                        <Button fx:id="updateVotesButton"
                                text="Submit Final Result"
                                onAction="#handleUpdateVotes"
                                styleClass="success-button"/>

                        <Label fx:id="statusLabel"
                               wrapText="true"
                               styleClass="status-label"/>

                        <Separator/>

                        <Label text="Messages with Super Admin"
                               styleClass="card-title"/>

                        <ListView fx:id="messagesList"
                                  prefHeight="130"/>

                        <HBox spacing="10">

                            <TextField fx:id="replyField"
                                       promptText="Type message"
                                       HBox.hgrow="ALWAYS"/>

                            <Button fx:id="sendButton"
                                    text="Send"
                                    styleClass="primary-button"/>

                        </HBox>

                        <Label fx:id="messageStatusLabel"
                               wrapText="true"
                               styleClass="normal-text"/>

                        <Button fx:id="logoutButton"
                                text="Logout"
                                onAction="#handleLogout"
                                styleClass="danger-button"/>

                    </VBox>

                    <!-- RIGHT SIDE -->

                    <VBox spacing="18"
                          prefWidth="500"
                          styleClass="section-card">

                        <VBox spacing="10"
                              styleClass="message-panel">

                            <Label text="NID Registration"
                                   styleClass="card-title"/>

                            <TextField fx:id="nidRegisterField"
                                       promptText="Enter NID"/>

                            <Button fx:id="registerButton"
                                    text="Register NID"
                                    styleClass="primary-button"/>

                            <Label fx:id="registerStatusLabel"
                                   wrapText="true"
                                   styleClass="normal-text"/>

                            <VBox alignment="CENTER"
                                  styleClass="stat-card">

                                <Label text="REGISTERED VOTERS"
                                       styleClass="normal-text"/>

                                <Label fx:id="registeredCountLabel"
                                       text="Registered: 0"
                                       styleClass="section-title"/>

                            </VBox>

                        </VBox>

                        <VBox spacing="10"
                              styleClass="success-panel">

                            <Label text="Record Vote Cast"
                                   styleClass="card-title"/>

                            <Label text="This records only that the voter has cast a ballot. Candidate votes are entered separately."
                                   wrapText="true"
                                   styleClass="normal-text"/>

                            <TextField fx:id="nidVoteField"
                                       promptText="Enter NID"/>

                            <Button fx:id="voteButton"
                                    text="Verify &amp; Record Vote Cast"
                                    styleClass="success-button"/>

                            <Label fx:id="voteStatusLabel"
                                   wrapText="true"
                                   styleClass="normal-text"/>

                            <VBox alignment="CENTER"
                                  styleClass="stat-card success-card">

                                <Label text="LIVE VOTES CAST"
                                       styleClass="normal-text"/>

                                <Label fx:id="votedCountLabel"
                                       text="Live Votes Cast: 0"
                                       styleClass="section-title"/>

                            </VBox>

                            <Label text="This number updates automatically."
                                   styleClass="normal-text"/>

                        </VBox>

                    </VBox>

                </HBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
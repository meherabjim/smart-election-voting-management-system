<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.SuperAdminDashboardController"
            prefWidth="900"
            prefHeight="680"
            stylesheets="@app-theme.css"
            styleClass="page-shell">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox alignment="CENTER"
              styleClass="top-banner">

            <Label text="ELECTION COMMISSIONER DASHBOARD"
                   styleClass="main-title"/>

            <Label text="Super Admin Control Center"
                   styleClass="subtitle"/>

        </VBox>

    </top>

    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;">

            <content>

                <VBox alignment="TOP_CENTER"
                      spacing="16">

                    <padding>
                        <Insets top="22"
                                right="45"
                                bottom="22"
                                left="45"/>
                    </padding>

                    <VBox spacing="15"
                          maxWidth="800"
                          styleClass="section-card">

                        <!-- TITLE -->

                        <Label text="Polling Station Administration"
                               styleClass="section-title"/>

                        <!-- LOCATION SELECTION -->

                        <HBox spacing="10"
                              alignment="CENTER"
                              styleClass="message-panel">

                            <ComboBox fx:id="divCombo"
                                      promptText="Division"
                                      onAction="#handleDivSelect"
                                      prefWidth="150"/>

                            <ComboBox fx:id="disCombo"
                                      promptText="District"
                                      onAction="#handleDisSelect"
                                      prefWidth="150"/>

                            <ComboBox fx:id="upaCombo"
                                      promptText="Upazila"
                                      onAction="#handleUpaSelect"
                                      prefWidth="150"/>

                            <ComboBox fx:id="stationCombo"
                                      promptText="Polling Station"
                                      prefWidth="190"/>

                        </HBox>

                        <!-- ADMIN ASSIGNMENT -->

                        <HBox spacing="10"
                              alignment="CENTER"
                              styleClass="message-panel">

                            <TextField fx:id="adminEmailField"
                                       promptText="Admin Email"
                                       prefWidth="220"/>

                            <PasswordField fx:id="adminPasswordField"
                                           promptText="Password"
                                           prefWidth="180"/>

                            <Button text="Assign Admin"
                                    onAction="#handleAssignAdmin"
                                    styleClass="primary-button"/>

                        </HBox>

                        <!-- ADMIN TABLE -->

                        <TableView fx:id="adminTable"
                                   prefHeight="170">

                            <columns>

                                <TableColumn fx:id="stationCol"
                                             text="Polling Station"
                                             prefWidth="360"/>

                                <TableColumn fx:id="adminEmailCol"
                                             text="Admin Email"
                                             prefWidth="360"/>

                            </columns>

                        </TableView>

                        <Label fx:id="statusLabel"
                               wrapText="true"
                               styleClass="status-label"/>

                        <Separator/>

                        <!-- COMMUNICATION -->

                        <Label text="Communication Center"
                               styleClass="section-title"/>

                        <HBox spacing="10"
                              alignment="CENTER"
                              styleClass="message-panel">

                            <TextField fx:id="broadcastField"
                                       promptText="Type broadcast message"
                                       HBox.hgrow="ALWAYS"/>

                            <Button fx:id="broadcastButton"
                                    text="Broadcast"
                                    styleClass="success-button"/>

                        </HBox>

                        <Label text="Messages from Polling Stations"
                               styleClass="card-title"/>

                        <ListView fx:id="messagesList"
                                  prefHeight="150"/>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <!-- ================= FIXED FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="10"
              styleClass="bottom-bar">

            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="130"
                    prefHeight="40"
                    styleClass="danger-button"/>

        </HBox>

    </bottom>

</BorderPane>
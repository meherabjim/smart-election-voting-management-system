<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="430" prefWidth="480"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.SuperAdminDashboardController"
            style="-fx-background-color: linear-gradient(to bottom right, #43cea2, #185a9d);">

    <VBox alignment="TOP_CENTER" spacing="10"
          prefWidth="440" AnchorPane.leftAnchor="20" AnchorPane.topAnchor="15"
          style="-fx-background-color: rgba(255,255,255,0.18);
                 -fx-background-radius: 15; -fx-padding: 20;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 8, 0, 0, 3);">

        <!-- ====== Title ====== -->
        <Label text="Election Commissioner Dashboard"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold';
                      -fx-padding: 0 0 8 0;" />

        <!-- ====== Location Selection ====== -->
        <HBox spacing="8" alignment="CENTER"
              style="-fx-background-color: rgba(255,255,255,0.35);
                     -fx-background-radius: 8; -fx-padding: 8;">
            <ComboBox fx:id="divCombo" promptText="Division" onAction="#handleDivSelect" prefWidth="90" />
            <ComboBox fx:id="disCombo" promptText="District" onAction="#handleDisSelect" prefWidth="90" />
            <ComboBox fx:id="upaCombo" promptText="Upazila" onAction="#handleUpaSelect" prefWidth="90" />
            <ComboBox fx:id="stationCombo" promptText="Polling Station" prefWidth="120" />
        </HBox>

        <!-- ====== Admin Assignment ====== -->
        <HBox spacing="8" alignment="CENTER"
              style="-fx-background-color: rgba(255,255,255,0.45);
                     -fx-background-radius: 8; -fx-padding: 8;">
            <TextField fx:id="adminEmailField" promptText="Admin Email" prefWidth="130"
                       style="-fx-background-radius: 6; -fx-padding: 5 10 5 10;" />
            <PasswordField fx:id="adminPasswordField" promptText="Password" prefWidth="100"
                           style="-fx-background-radius: 6; -fx-padding: 5 10 5 10;" />
            <Button text="Assign Admin" onAction="#handleAssignAdmin"
                    style="-fx-font-size: 12px; -fx-background-color: #1976d2;
                           -fx-background-radius: 8; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 6 16 6 16;
                           -fx-cursor: hand;" />
        </HBox>

        <!-- ====== Admin Table ====== -->
        <TableView fx:id="adminTable" prefHeight="80" prefWidth="350"
                   style="-fx-background-color: white; -fx-background-radius: 8;
                          -fx-border-color: #1565c0; -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="stationCol" prefWidth="170" text="Polling Station" />
                <TableColumn fx:id="adminEmailCol" prefWidth="170" text="Admin Email" />
            </columns>
        </TableView>

        <Label fx:id="statusLabel"
               style="-fx-font-size: 12px; -fx-text-fill: #00e676; -fx-font-weight: bold;"/>

        <Separator style="-fx-padding: 4 0 4 0;" />

        <!-- ====== Broadcast Area ====== -->
        <HBox spacing="8" alignment="CENTER"
              style="-fx-background-color: rgba(255,255,255,0.35);
                     -fx-background-radius: 8; -fx-padding: 8;">
            <TextField fx:id="broadcastField" promptText="Type broadcast message"
                       prefWidth="180" style="-fx-background-radius: 6; -fx-padding: 5 10 5 10;" />
            <Button fx:id="broadcastButton" text="Broadcast"
                    style="-fx-font-size: 12px; -fx-background-color: #388e3c;
                           -fx-background-radius: 8; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 6 16 6 16;
                           -fx-cursor: hand;" />
        </HBox>

        <!-- ====== Messages ====== -->
        <Label text="Messages from Polling Stations"
               style="-fx-font-weight: bold; -fx-font-size: 12px;
                      -fx-text-fill: white; -fx-padding: 6 0 4 0;" />

        <ListView fx:id="messagesList" prefHeight="70" prefWidth="350"
                  style="-fx-background-radius: 8; -fx-background-color: #f9fdff;
                         -fx-border-color: #1976d2; -fx-border-radius: 8;" />

        <!-- ====== Logout Button ====== -->
        <Button text="Logout" onAction="#handleLogout"
                style="-fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-background-radius: 8; -fx-background-color: #d32f2f;
                       -fx-text-fill: white; -fx-padding: 6 20 6 20;
                       -fx-cursor: hand;" />
    </VBox>
</AnchorPane>

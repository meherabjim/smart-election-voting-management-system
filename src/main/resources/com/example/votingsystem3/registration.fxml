<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.RegistrationController"
            prefWidth="760"
            prefHeight="520"
            stylesheets="@app-theme.css"
            styleClass="page-shell">

    <top>
        <VBox alignment="CENTER"
              styleClass="top-banner">

            <Label text="CREATE USER ACCOUNT"
                   styleClass="main-title"/>

            <Label text="Smart Election Voting Management System"
                   styleClass="subtitle"/>

        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER">

            <padding>
                <Insets top="35"
                        right="30"
                        bottom="35"
                        left="30"/>
            </padding>

            <VBox alignment="CENTER"
                  spacing="17"
                  styleClass="login-card">

                <Label text="User Registration"
                       styleClass="section-title"/>

                <Label text="Create an account to access the election monitoring system."
                       wrapText="true"
                       maxWidth="330"
                       styleClass="normal-text"/>

                <TextField fx:id="emailField"
                           promptText="Email"
                           prefWidth="330"/>

                <PasswordField fx:id="passwordField"
                               promptText="Password"
                               prefWidth="330"/>

                <HBox alignment="CENTER"
                      spacing="14">

                    <Button text="Register"
                            onAction="#handleRegister"
                            prefWidth="115"
                            styleClass="success-button"/>

                    <Button text="Back to Login"
                            onAction="#handleBackToLogin"
                            prefWidth="135"
                            styleClass="secondary-button"/>

                </HBox>

                <Label fx:id="statusLabel"
                       wrapText="true"
                       maxWidth="330"
                       styleClass="status-label"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>
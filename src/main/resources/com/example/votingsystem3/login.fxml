<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="420.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21.0.0"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #2193b0, #6dd5ed);">

    <!-- ======= Title ======= -->
    <Label layoutX="60" layoutY="35"
           text="Election Voting Management System"
           style="-fx-font-size: 26px; -fx-font-family: 'Segoe UI Semibold';
                  -fx-text-fill: white; -fx-font-weight: bold;" />

    <!-- ======= Center Card ======= -->
    <VBox layoutX="150" layoutY="110" spacing="15" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 25;
                 -fx-background-radius: 16;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 5);">

        <Label text="Login to Your Account"
               style="-fx-font-size: 20px; -fx-font-weight: bold;
                      -fx-text-fill: #1565c0; -fx-padding: 0 0 10 0;" />

        <!-- Email Field -->
        <TextField fx:id="emailField" promptText="Email"
                   prefWidth="250"
                   style="-fx-font-size: 14px; -fx-background-radius: 8;
                          -fx-background-color: #f5f5f5;
                          -fx-border-color: #90caf9; -fx-border-radius: 8;" />

        <!-- Password Field -->
        <PasswordField fx:id="passwordField" promptText="Password"
                       prefWidth="250"
                       style="-fx-font-size: 14px; -fx-background-radius: 8;
                              -fx-background-color: #f5f5f5;
                              -fx-border-color: #90caf9; -fx-border-radius: 8;" />

        <!-- Buttons Row -->
        <HBox alignment="CENTER" spacing="15">
            <Button text="Login" onAction="#handleLogin"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-padding: 6 20 6 20; -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 6, 0, 0, 3);" />
            <Button text="Register" onAction="#handleRegister"
                    style="-fx-background-color: #1976d2; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-padding: 6 20 6 20; -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 6, 0, 0, 3);" />
        </HBox>

        <!-- Status Label -->
        <Label fx:id="statusLabel" textFill="#1b5e20"
               style="-fx-font-size: 14px; -fx-padding: 5 0 0 0;" />

    </VBox>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.votingsystem3.controllers.UserDashboardController"
            prefWidth="1100"
            prefHeight="720"
            stylesheets="@app-theme.css"
            styleClass="page-shell">

    <top>

        <VBox alignment="CENTER"
              styleClass="top-banner">

            <Label text="LIVE ELECTION MONITORING"
                   styleClass="main-title"/>

            <Label text="Bangladesh Election Live Monitoring Dashboard"
                   styleClass="subtitle"/>

        </VBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <VBox alignment="TOP_CENTER"
                      spacing="20"
                      fillWidth="true">

                    <padding>
                        <Insets top="20"
                                right="40"
                                bottom="25"
                                left="40"/>
                    </padding>

                    <!-- BANGLADESH LIVE COUNT -->

                    <VBox alignment="CENTER"
                          spacing="7"
                          maxWidth="1000"
                          prefWidth="1000"
                          styleClass="section-card">

                        <Label text="BANGLADESH LIVE VOTE CAST"
                               styleClass="normal-text"/>

                        <Label fx:id="bangladeshLiveCountLabel"
                               text="Bangladesh Live Votes Cast: 0"
                               styleClass="section-title"/>

                        <Label text="The national vote-cast total updates automatically."
                               styleClass="normal-text"/>

                    </VBox>

                    <!-- BANGLADESH SUBMITTED RESULT -->

                    <VBox alignment="CENTER"
                          spacing="13"
                          maxWidth="1000"
                          prefWidth="1000"
                          styleClass="section-card">

                        <Label text="Bangladesh Submitted Results"
                               styleClass="section-title"/>

                        <Label text="Only polling stations that submitted final results are included."
                               alignment="CENTER"
                               wrapText="true"
                               styleClass="normal-text"/>

                        <Separator/>

                        <VBox alignment="CENTER"
                              spacing="4"
                              maxWidth="600"
                              styleClass="purple-panel">

                            <Label text="RESULT SUBMISSION PROGRESS"
                                   styleClass="normal-text"/>

                            <Label fx:id="nationalProgressLabel"
                                   text="Final results submitted: 0 / 0 polling stations"
                                   alignment="CENTER"
                                   wrapText="true"
                                   styleClass="card-title"/>

                        </VBox>

                        <HBox alignment="CENTER"
                              spacing="20">

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  styleClass="stat-card success-card">

                                <Label text="TOTAL VALID VOTES"
                                       styleClass="normal-text"/>

                                <Label fx:id="nationalValidLabel"
                                       text="Valid Votes: 0"
                                       styleClass="success-text"/>

                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  styleClass="stat-card danger-card">

                                <Label text="TOTAL INVALID VOTES"
                                       styleClass="normal-text"/>

                                <Label fx:id="nationalInvalidLabel"
                                       text="Invalid Votes: 0"
                                       styleClass="danger-text"/>

                            </VBox>

                        </HBox>

                        <Label text="Candidate-wise Bangladesh Total"
                               styleClass="card-title"/>

                        <TableView fx:id="bdTable"
                                   prefHeight="190"
                                   maxWidth="930">

                            <placeholder>
                                <Label text="No polling station result has been submitted."
                                       styleClass="normal-text"/>
                            </placeholder>

                            <columns>

                                <TableColumn fx:id="candidateCol2"
                                             text="Candidate"
                                             prefWidth="600"/>

                                <TableColumn fx:id="votesCol2"
                                             text="Submitted Total Votes"
                                             prefWidth="300"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- POLLING STATION SELECTION -->

                    <VBox alignment="CENTER"
                          spacing="14"
                          maxWidth="1000"
                          prefWidth="1000"
                          styleClass="section-card">

                        <Label text="Polling Station Live Monitoring"
                               styleClass="section-title"/>

                        <Label text="Select Division, District, Upazila and Polling Station."
                               styleClass="normal-text"/>

                        <Separator/>

                        <HBox alignment="CENTER"
                              spacing="12">

                            <VBox spacing="5">

                                <Label text="Division"
                                       styleClass="card-title"/>

                                <ComboBox fx:id="divCombo"
                                          promptText="Select Division"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="District"
                                       styleClass="card-title"/>

                                <ComboBox fx:id="disCombo"
                                          promptText="Select District"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="Upazila"
                                       styleClass="card-title"/>

                                <ComboBox fx:id="upaCombo"
                                          promptText="Select Upazila"
                                          prefWidth="205"
                                          prefHeight="38"/>

                            </VBox>

                            <VBox spacing="5">

                                <Label text="Polling Station"
                                       styleClass="card-title"/>

                                <ComboBox fx:id="stationCombo"
                                          promptText="Select Polling Station"
                                          prefWidth="245"
                                          prefHeight="38"/>

                            </VBox>

                        </HBox>

                        <VBox alignment="CENTER"
                              spacing="4"
                              maxWidth="720"
                              styleClass="message-panel">

                            <Label text="SELECTED POLLING STATION LIVE STATUS"
                                   styleClass="normal-text"/>

                            <Label fx:id="selectedStationLiveCountLabel"
                                   text="Select a polling station."
                                   alignment="CENTER"
                                   wrapText="true"
                                   styleClass="section-title"/>

                        </VBox>

                    </VBox>

                    <!-- SELECTED STATION RESULT -->

                    <VBox alignment="CENTER"
                          spacing="13"
                          maxWidth="1000"
                          prefWidth="1000"
                          styleClass="section-card">

                        <Label text="Selected Polling Station Final Result"
                               styleClass="section-title"/>

                        <Label fx:id="stationResultStatusLabel"
                               text="Select a polling station to see its result status."
                               alignment="CENTER"
                               wrapText="true"
                               styleClass="status-label"/>

                        <HBox alignment="CENTER"
                              spacing="20">

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  styleClass="stat-card success-card">

                                <Label text="STATION VALID VOTES"
                                       styleClass="normal-text"/>

                                <Label fx:id="stationValidLabel"
                                       text="Valid Votes: 0"
                                       styleClass="success-text"/>

                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="3"
                                  prefWidth="260"
                                  styleClass="stat-card danger-card">

                                <Label text="STATION INVALID VOTES"
                                       styleClass="normal-text"/>

                                <Label fx:id="stationInvalidLabel"
                                       text="Invalid Votes: 0"
                                       styleClass="danger-text"/>

                            </VBox>

                        </HBox>

                        <TableView fx:id="stationTable"
                                   prefHeight="210"
                                   maxWidth="930">

                            <placeholder>

                                <Label text="No submitted result is available for the selected polling station."
                                       styleClass="normal-text"/>

                            </placeholder>

                            <columns>

                                <TableColumn fx:id="candidateCol1"
                                             text="Candidate"
                                             prefWidth="600"/>

                                <TableColumn fx:id="votesCol1"
                                             text="Polling Station Votes"
                                             prefWidth="300"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <bottom>

        <HBox alignment="CENTER"
              styleClass="bottom-bar">

            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="110"
                    prefHeight="38"
                    styleClass="danger-button"/>

        </HBox>

    </bottom>

</BorderPane>